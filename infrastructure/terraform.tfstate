          "schema_version": 0,
          "attributes": {
            "id": "cc516a9253c822de",
            "meta_data": "\"instance-id\": \"cp\"\n\"local-hostname\": \"cp\"\n",
            "name": "cp-cloudinit.iso",
            "network_config": null,
            "path": "/tmp/terraform-provider-libvirt-cloudinit/cloudinit-cc516a9253c822de.iso",
            "size": 51200,
            "user_data": "#cloud-config\n\n# Network\nnetwork:\n  version: 2\n  renderer: networkd\n\n  ethernets:\n    primary:\n      match:\n        driver: virtio_net\n      dhcp4: true\n      dhcp-identifier: mac\n      optional: true\n\n# User Configuration\nusers:\n  - name: ubuntu\n    groups:\n      - sudo\n    shell: /bin/bash\n    # Allow the ubuntu user to execute sudo commands\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    # Disable password-based login.\n    lock_passwd: true\n    # SSH public key used to access the VM.\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAING547SX9VRSPrcFxtjGudry9trHOASoUHHSxtfp3ttz marwen@laptop\n\n# SSH\n# Disable SSH password authentication.\nssh_pwauth: false\n# Package Installation\npackage_update: true\npackages:\n  # Allows libvirt/KVM to communicate with the guest.\n  - qemu-guest-agent\n\n# Kubernetes bootstrap files\n\n# The CA is only written on the control-plane. Terraform generated\n# it up front (pki.tf) so the resulting discovery-token-ca-cert-hash\n# is already known and baked into every worker's bootstrap script\n# below -- kubeadm init here just reuses this CA instead of generating a different one.\n\nwrite_files:\n  - path: /etc/kubernetes/pki/ca.crt\n    permissions: '0644'\n    owner: root:root\n    content: |\n      -----BEGIN CERTIFICATE-----\n      MIIDITCCAgmgAwIBAgIRAMoX7uWt6L/ftpRqh3o1C4YwDQYJKoZIhvcNAQELBQAw\n      KjETMBEGA1UEChMKa3ViZXJuZXRlczETMBEGA1UEAxMKa3ViZXJuZXRlczAeFw0y\n      NjA5MjEyMzI5MTJaFw0zNjA5MTgyMzI5MTJaMCoxEzARBgNVBAoTCmt1YmVybmV0\n      ZXMxEzARBgNVBAMTCmt1YmVybmV0ZXMwggEiMA0GCSqGSIb3DQEBAQUAA4IBDwAw\n      ggEKAoIBAQDJ5TJEN3XCPmyoxq4lfi+uzNySttjFn1Oqwv1pr1qrvg7xh6uF7zQp\n      hqQ2u+gf6HJUgYf6RXPS/G5dhyFBN/cS/kpucU/AyZ6oz6xtcT1OXA1ZBiwhwhV1\n      S1pCH4xX6Lj/B/y2P7Hv3IrtR1bT7RX5uLPDQrhxgLixAc05JahWu3V5Vi0zUrS7\n      iHjOzODVXaKkFqQ2l+Mkj4kayJDp/pWdbJYrVHGMR05/qSYLp4lMTuT5PHg/1AkM\n      iwJnyW4Skmap/QLD6D6fxDJ2uG2JDc+wuqQ4cfvjEXZeXjkz4fEc9MmWBwBbUrt/\n      gAFYLVfVxPSHEDC2+HOuR3pX2DzA0vy1AgMBAAGjQjBAMA4GA1UdDwEB/wQEAwIB\n      pjAPBgNVHRMBAf8EBTADAQH/MB0GA1UdDgQWBBTfhWLFkybPs6YTjUiplbveHKtQ\n      rDANBgkqhkiG9w0BAQsFAAOCAQEAe3enLXT6WMDV+pAxuFiph+Je3clq1Wc1Y33N\n      wfndq4eflm+QZb5iI7GTZVOVZNxLNbwI5e1sKfTc1xMT+oQ6p/l4ugHerz1CJLqJ\n      X08iegDnTGsSSrHMySQusrGS7VIwzpg2ISK7OE8ybOFrh2MEFmAHm0vMmTEA8jzJ\n      xHjR2FwTrtSEp2L70LdE8o6uDiUNEOAXhmED1EXleFZxbMli8/KSxn9LcF4p++aR\n      g3ejem8S5BRdG6kbkSr82aKKTBONKJJORuAbS2pRRqqw7BQKc8wF6fRclw0jjxWl\n      P9Otky7u2DZSOdU+19azJY8h//mzsA9HLQ8EesEbVivkpmR8Ow==\n      -----END CERTIFICATE-----\n      \n  - path: /etc/kubernetes/pki/ca.key\n    permissions: '0600'\n    owner: root:root\n    content: |\n      -----BEGIN RSA PRIVATE KEY-----\n      MIIEowIBAAKCAQEAyeUyRDd1wj5sqMauJX4vrszckrbYxZ9TqsL9aa9aq74O8Yer\n      he80KYakNrvoH+hyVIGH+kVz0vxuXYchQTf3Ev5KbnFPwMmeqM+sbXE9TlwNWQYs\n      IcIVdUtaQh+MV+i4/wf8tj+x79yK7UdW0+0V+bizw0K4cYC4sQHNOSWoVrt1eVYt\n      M1K0u4h4zszg1V2ipBakNpfjJI+JGsiQ6f6VnWyWK1RxjEdOf6kmC6eJTE7k+Tx4\n      P9QJDIsCZ8luEpJmqf0Cw+g+n8QydrhtiQ3PsLqkOHH74xF2Xl45M+HxHPTJlgcA\n      W1K7f4ABWC1X1cT0hxAwtvhzrkd6V9g8wNL8tQIDAQABAoIBAByzYNhyu+JPpnm9\n      uL7qt9OVGtwecyVw11+ElarC+1RD0fMC8t642QT4N3rybnauwCYEPfTVj7gUG4pf\n      LdqMHqsMDD+0Cv7gipX748qxGOJ9UoZvyrFH2m4QtrWEr5pFoprao1GzL1PmWbeO\n      dyjsYL3dxGxDHV5BSsAa/fYcRNiDT9tIi5r7qH3+Ibl3pzScu9yee56//Su+8IJI\n      A+JmfqI/qlgDUxXK7VkjZvPDdhxL6bY7o0xDI4sJpKNx08phXmksF9vmYMaKWTIO\n      Wzt0jf056qwHzgdwFFdkH9zBfot7zYYvAQYzya0+Fbvps/uXBYjILTo4cafctz+Q\n      H7X7fscCgYEA8KohtEzRj+hzd5PJBCS4Tfd3Zm1P5oEvFtlnu3Z7YOhBXqhYBMu4\n      aLNLEWphHjg3uIMCuju/xEYb8z2Z425mz4qGYclhD39UPFfDmcmioLUbgN6kCQkQ\n      /qN56L6rs2xkyVJ2Z9URfq2UUK+DgMqV3RA41W6cB7d7KRFpw2VX0+8CgYEA1sKi\n      7HV6zA1jIgXgMNIdqIAZFigJWkb2+m5RbYD3ZW73u+j+dJuSgdTBVEBEEoXrBB6y\n      tsAutTz/MODHYRax2q1AHIG6SeEALIQ5v4PoK1ka1WydKNppOGvWlP3Zz12Yspjs\n      w/YxMZSjInyvuSOxvysspf+fJ+DqUhB3zyCeBZsCgYB72TGrFXUqt5bkTHs/1J28\n      EcOyREK//m77NTo6sIhhoGQzkDJrlWL7DnltJu9/m7KhE1qN+D2BhgrQLD1LWv8x\n      groRDI8UaJQy0X9pXuiAB3N16B1GQRIr2HjeG3FEzl03dWZVnMJ6DF2tAAWOe7KP\n      ps94lolZN0T8J2fkE/0UpQKBgAljbt3pcNnUx/2nxho8RUGlf/NBAs+ohImEIxkn\n      ZylPBZN4Zw9P8cKtO1pkiNVKd3CxqtxkYGZZ6UoIuY6cAGBv7HqSjUNHi8tmaGPf\n      71ldxteHrQMpMSpfRH00772p+M/t8YPLknD5b3xFeSUd01ppF8WV/C4xHe1CfQpY\n      AbB7AoGBALgf/KoryCsIVAED3/bc4yg7HWObWDLLcPliTb8/E4413t/FBIKOqy5p\n      SldnVMDk6ZBuyiMPkaAOR1JZ023AYzNnMjYwUjyIcNOw8n0SksJ/Oh+ZHcJF7gnu\n      +AbWoXRtklksZZd8dJ5L3sMDi7J/iVlm2IGvOa3caBDIiBl8gcZa\n      -----END RSA PRIVATE KEY-----\n      \n  - path: /root/bootstrap.sh\n    permissions: '0700'\n    owner: root:root\n    content: |\n      #!/usr/bin/env bash\n      set -euxo pipefail\n      exec \u003e \u003e(tee -a /var/log/k8s-bootstrap.log) 2\u003e\u00261\n      \n      echo \"=== [1/5] Disable swap (persistently) ===\"\n      swapoff -a || true\n      sed -i.bak '/swap/s/^/#/' /etc/fstab\n      \n      echo \"=== [2/5] Load kernel modules ===\"\n      cat \u003c\u003c'EOF' \u003e /etc/modules-load.d/k8s.conf\n      overlay\n      br_netfilter\n      EOF\n      modprobe overlay\n      modprobe br_netfilter\n      \n      echo \"=== [3/5] sysctl for Kubernetes networking ===\"\n      cat \u003c\u003c'EOF' \u003e /etc/sysctl.d/k8s.conf\n      net.bridge.bridge-nf-call-iptables = 1\n      net.bridge.bridge-nf-call-ip6tables = 1\n      net.ipv4.ip_forward = 1\n      EOF\n      sysctl --system\n      \n      echo \"=== [4/5] Install and configure containerd ===\"\n      export DEBIAN_FRONTEND=noninteractive\n      apt-get update\n      apt-get install -y containerd\n      mkdir -p /etc/containerd\n      containerd config default \u003e /etc/containerd/config.toml\n      sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml\n      systemctl restart containerd\n      systemctl enable containerd\n      \n      echo \"=== [5/5] Install kubeadm, kubelet, kubectl ===\"\n      apt-get install -y apt-transport-https ca-certificates curl gpg\n      mkdir -p -m 755 /etc/apt/keyrings\n      curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key \\\n        | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg\n      echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /' \\\n        \u003e /etc/apt/sources.list.d/kubernetes.list\n      apt-get update\n      apt-get install -y kubelet kubeadm kubectl\n      apt-mark hold kubelet kubeadm kubectl\n      \n      echo \"=== Control-plane: kubeadm init ===\"\n      # /etc/kubernetes/pki/ca.crt + ca.key were already written by cloud-init\n      # write_files below. kubeadm detects them and reuses this CA instead of\n      # generating a new one -- this is what makes the pre-computed\n      # discovery-token-ca-cert-hash baked into the workers' cloud-init valid.\n      kubeadm init \\\n        --token=abcdef.0123456789abcdef \\\n        --token-ttl=0 \\\n        --apiserver-advertise-address=192.168.71.104 \\\n        --pod-network-cidr=192.168.0.0/16 \\\n        --node-name=cp\n      \n      mkdir -p /home/ubuntu/.kube\n      cp -i /etc/kubernetes/admin.conf /home/ubuntu/.kube/config\n      chown -R ubuntu:ubuntu /home/ubuntu/.kube\n      \n      echo \"=== Control-plane: install Calico (retrying on transient pull/network issues) ===\"\n      export KUBECONFIG=/etc/kubernetes/admin.conf\n      for i in $(seq 1 10); do\n        if kubectl apply -f https://raw.githubusercontent.com/projectcalico/calico/v3.32.2/manifests/calico.yaml; then\n          break\n        fi\n        echo \"Calico apply attempt $i failed, retrying in 15s...\"\n        sleep 15\n      done\n      \n      #change  2nd for cp -\u003e cp name\n      \n      echo \"=== Control-plane: best-effort background worker role labeling ===\"\n      nohup bash -c '\n        export KUBECONFIG=/etc/kubernetes/admin.conf\n        for i in $(seq 1 60); do \n          for n in $(kubectl get nodes -o name 2\u003e/dev/null | grep -v cp || true); do   \n            kubectl label \"$n\" node-role.kubernetes.io/worker= --overwrite 2\u003e/dev/null || true\n          done\n          sleep 15\n        done\n      ' \u003e /var/log/k8s-label-workers.log 2\u003e\u00261 \u0026\n      \n      \n      echo \"=== Bootstrap complete for cp (role=control-plane) ===\"\n      \n\n\n# Commands\n\nruncmd:\n  # Start the QEMU Guest Agent immediately\n  # and enable it automatically at boot.\n  - systemctl enable --now qemu-guest-agent\n\n  # Full node prep + kubeadm init/join + (control-plane only) Calico.\n  # See /var/log/k8s-auto-bootstrap.log for progress/troubleshooting.\n  - bash /root/bootstrap.sh\n"
          },
